VITE_API_URL=http://localhost:3000/api/v1

# Apex domain that storefront subdomains hang off, e.g. `midominio.com` makes
# `mitienda.midominio.com` serve the `mitienda` storefront at the root path.
# Leave empty to reach stores only at /store/<slug>.
# `*.localhost` resolves to 127.0.0.1, so `localhost` works for local testing.
VITE_STOREFRONT_ROOT_DOMAIN=
